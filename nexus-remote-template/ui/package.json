{
  "name": "nexus-remote-ui",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS Module-Federation remote (micro-frontend) template UI",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "NODE_ENV=production webpack --mode production",
    "postbuild": "node scripts/check-csp.cjs",
    "check:csp": "node scripts/check-csp.cjs",
    "check:csp:strict": "node scripts/check-csp.cjs --strict",
    "start": "node serve.cjs"
  },
  "scriptsComment": "`postbuild` runs the NEXUS host-CSP compliance check automatically after every `npm run build`, so a bundle that would be blocked when embedded (eval'd chunks, inline <script>, self-hosted fonts, same-origin workers) fails HERE instead of rendering a blank tile in prod. The contract it enforces is ui/nexus-csp.json \u2014 do not widen that file to make a build pass; request a host change instead.",
  "dependencies": {
    "@azure/msal-browser": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.9.0",
    "postcss": "^8.4.38",
    "postcss-loader": "^8.1.1",
    "style-loader": "^3.3.4",
    "tailwindcss": "^3.4.4",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0"
  }
}
